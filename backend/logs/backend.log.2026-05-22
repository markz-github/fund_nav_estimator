": 0, "tv_vip_pay_type": 0, "tv_due_date": "0", "avatar_icon": {"icon_type": 0, "icon_resource": {"type": 0, "url": ""}}}, "official_verify": {"type": -1, "desc": ""}, "decorate": null, "decoration_card": null, "is_top": false, "icon_badge": null}, "module_more": {"rcmd_text": "", "three_point_items": [{"label": "举报", "type": "THREE_POINT_REPORT", "params": {}, "modal": null, "jump_url": ""}]}, "module_dispute": null, "module_dynamic": {"topic": null, "desc": null, "major": {"type": "MAJOR_TYPE_OPUS", "none": null, "blocked": null, "archive": null, "pgc": null, "courses": null, "draw": null, "article": null, "music": null, "common": null, "upower_common": null, "live": null, "live_rcmd": null, "medialist": null, "subscription": null, "ugc_season": null, "subscription_new": null, "opus": {"jump_url": "//www.bilibili.com/opus/1204347746548449349", "title": "5.20日：午评！", "summary": {"text": "指数今天午前继续回落，昨日反弹38个点，今天午前回落25个点，个股再度普跌，跌超4300家。\n \n但我昨天的收评就提醒了，这里要不以涨喜，不以跌悲，不然会被市场玩死，因为这里就是拉锯，涨涨跌跌大概率才是这里的常态。\n \n板块方面，今天依旧是半导体存储芯片领涨，逻辑不必多说，这波下跌其没什么跌幅，说明回调意愿，资金流出有限，所以还能抻，但在我来看也主要是抻，涨多了最后到了节点该调也要调。\n \n差别只是你4月22日布控持仓等抻等结束，还是过程耐不住想追涨的差别。\n...", "rich_text_nodes": [{"text": "指数今天午前继续回落，昨日反弹38个点，今天午前回落25个点，个股再度普跌，跌超4300家。", "orig_text": "指数今天午前继续回落，昨日反弹38个点，今天午前回落25个点，个股再度普跌，跌超4300家。", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": " ", "orig_text": " ", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "但我昨天的收评就提醒了，这里要不以涨喜，不以跌悲，不然会被市场玩死，因为这里就是拉锯，涨涨跌跌大概率才是这里的常态。", "orig_text": "但我昨天的收评就提醒了，这里要不以涨喜，不以跌悲，不然会被市场玩死，因为这里就是拉锯，涨涨跌跌大概率才是这里的常态。", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": " ", "orig_text": " ", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "板块方面，今天依旧是半导体存储芯片领涨，逻辑不必多说，这波下跌其没什么跌幅，说明回调意愿，资金流出有限，所以还能抻，但在我来看也主要是抻，涨多了最后到了节点该调也要调。", "orig_text": "板块方面，今天依旧是半导体存储芯片领涨，逻辑不必多说，这波下跌其没什么跌幅，说明回调意愿，资金流出有限，所以还能抻，但在我来看也主要是抻，涨多了最后到了节点该调也要调。", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": " ", "orig_text": " ", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "差别只是你4月22日布控持仓等抻等结束，还是过程耐不住想追涨