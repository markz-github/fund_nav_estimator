": null}, "module_more": {"rcmd_text": "", "three_point_items": [{"label": "举报", "type": "THREE_POINT_REPORT", "params": {}, "modal": null, "jump_url": ""}]}, "module_dispute": null, "module_dynamic": {"topic": null, "desc": null, "major": {"type": "MAJOR_TYPE_OPUS", "none": null, "blocked": null, "archive": null, "pgc": null, "courses": null, "draw": null, "article": null, "music": null, "common": null, "upower_common": null, "live": null, "live_rcmd": null, "medialist": null, "subscription": null, "ugc_season": null, "subscription_new": null, "opus": {"jump_url": "//www.bilibili.com/opus/1203303566937161729", "title": "一些宏观结论的加更（5/17）", "summary": {"text": "（1） 中美谈判，可能不那么符合预期（迟迟没有有具体数字的通稿+波音200架不及预期）\n（2） 中东局势，可能随时升级，关键的节点在普京访华之后\n（3） 金属短期四重利空（沃什担忧+错判中美缓和+印度关税+油价压制），但已然进入越跌越买的时刻，无需猜测跌倒哪里，现在性价比已然凸显\n（4） 不再增加科技的仓位，正式进入”科技=资源“的临界点，后续可能逐步向金属资源继续倾斜，但科技内部延续持股待涨，如后续硬件回调，机器人可能顶上\n（5） 油价到了110了，开始关注电池与风电等新能源的线路\n（6） 仓位重的请开始控制仓位，或进行新能源等的仓位对冲，密切关注油价后续的波动\n\n不构成投资建议。\n\n", "rich_text_nodes": [{"text": "（1） 中美谈判，可能不那么符合预期（迟迟没有有具体数字的通稿+波音200架不及预期）\n（2） 中东局势，可能随时升级，关键的节点在普京访华之后\n（3） 金属短期四重利空（沃什担忧+错判中美缓和+印度关税+油价压制），但已然进入越跌越买的时刻，无需猜测跌倒哪里，现在性价比已然凸显\n（4） 不再增加科技的仓位，正式进入”科技=资源“的临界点，后续可能逐步向金属资源继续倾斜，但科技内部延续持股待涨，如后续硬件回调，机器人可能顶上\n（5） 油价到了110了，开始关注电池与风电等新能源的线路\n（6） 仓位重的请开始控制仓位，或进行新能源等的仓位对冲，密切关注油价后续的波动\n\n不构成投资建议。\n\n", "orig_text": "（1） 中美谈判，可能不那么符合预期（迟迟没有有具体数字的通稿+波音200架不及预期）\n（2） 中东局势，可能随时升级，关键的节点在普京访华之后\n（3） 金属短期四重利空（沃什担忧+错判中美缓和+印度关税+油价压制），但已然进入越跌越买的时刻，无需猜测跌倒哪里，现在性价比已然凸显\n（4） 不再增加科技的仓位，正式进入”科技=资源“的临界点，后续可能逐步向金属资源继续倾斜，但科技内部延续持股待涨，如后续硬件回调，机器人可能顶上\n（5） 油价到了110了，开始关注电池与风电等新能源的线路\n（6） 仓位重的请开始控制仓位，或进行新能源等的仓位对冲，密切关注油价后续的波动\n\n不构成投资建议。\n\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}], "paragraphs": [], "has_more": false}, "style": 0, "pics": [], "fold_action": ["展开", "收起"]}}, "additional": null}, "module_extend": null, "module_stat": {"forward": {"status": false, "count": 