sk": null, "is_critical_group": true}, "mid": "307610125"}, "face": "https://i1.hdslb.com/bfs/face/ffb2761eb282672a27a70bb3dafdcfc96b436f41.jpg", "face_nft": false, "nft_info": null, "name": "皓哥论股", "name_render": null, "label": "", "mid": 307610125, "jump_url": "//space.bilibili.com/307610125/dynamic", "following": false, "pub_ts": "1778816364", "pub_time": "05月15日", "pub_action": "投稿了文章", "pub_location_text": "", "pendant": {"pid": 0, "name": "", "image": "", "expire": "0", "image_enhance": "", "image_enhance_frame": "", "n_pid": "0"}, "vip": {"type": 1, "status": 0, "due_date": "1769356800000", "vip_pay_type": 0, "theme_type": 0, "label": {"path": "", "text": "", "label_theme": "", "text_color": "", "bg_style": 0, "bg_color": "", "border_color": "", "use_img_label": true, "img_label_uri_hans": "", "img_label_uri_hant": "", "img_label_uri_hans_static": "https://i0.hdslb.com/bfs/vip/d7b702ef65a976b20ed854cbd04cb9e27341bb79.png", "img_label_uri_hant_static": "https://i0.hdslb.com/bfs/activity-plat/static/20220614/e369244d0b14644f5e1a06431e22a4d5/KJunwh19T5.png"}, "avatar_subscript": 0, "nickname_color": "", "role": "0", "avatar_subscript_url": "", "tv_vip_status": 0, "tv_vip_pay_type": 0, "tv_due_date": "0", "avatar_icon": {"icon_type": 0, "icon_resource": {"type": 0, "url": ""}}}, "official_verify": {"type": -1, "desc": ""}, "decorate": null, "decoration_card": null, "is_top": false, "icon_badge": null}, "module_more": {"rcmd_text": "", "three_point_items": [{"label": "举报", "type": "THREE_POINT_REPORT", "params": {}, "modal": null, "jump_url": ""}]}, "module_dispute": null, "module_dynamic": {"topic": null, "desc": null, "major": {"type": "MAJOR_TYPE_OPUS", "none": null, "blocked": null, "archive": null, "pgc": null, "courses": null, "draw": null, "article": null, "music": null, "common": null, "upower_common": null, "live": null, "live_rcmd": null, "medialist": null, "subscription": null, "ugc_season": null, "subscription_new": null, "opus": {"jump_url": "//www.bilibili.com/opus/1202496199026802690", "title": "5.15日：午评！", "summary": {"text": "指数由开盘大跌转红，但并不意外，早报我已经将几大指数的结构图给到大家，开盘的下跌是将下三的第三浪补足，修复是反弹的第一浪，因此早报我们的结论是什么？这里还会拉锯！\n \n板块方面，软件今天还凑合，稳得住，开盘不跟跌反涨，AI硬件先跌后修复，说明科技的情绪还在，还能看！但是否要开始补涨却还不好说，但继续分摊看着即可。而我们AI硬件的两个中长，一个20CM，一个10CM，强度不缺，毕竟能定义中长本身就代表了不同的态度。\n...", "rich_text_nodes": [{"text": "指数由开盘大跌转红，但并不意外，早报我已经将几大指数的结构图给到大家，开盘的下跌是将下三的第三浪补足，修复是反弹的第一浪，因此早报我们的结论是什么？这里还会拉锯！", "orig_text": "指数由开盘大跌转红，但并不意外，早报我已经将几大指数的结构图给到大家，开盘的下跌是将下三的第三浪补足，修复是反弹的第一浪，因此早报我们的结论是什么？这里还会拉锯！", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": " ", "orig_text": " ", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "板块方面，软件今天还凑合，稳得住，开盘不跟跌反涨，AI硬件先跌后修复，说明科技的情绪还在，还能看！但是否要开始补涨却还不好说，但继续分摊看着即可。而我们AI硬件的两个中长，一个20CM，一个10CM，强度不缺，毕竟能定义中长本身就代表了不同的态度。", "orig_text": "板块方面，软件今天还凑合，稳得住，开盘不跟跌反涨，AI硬件先跌后修复，说明科技的情绪还在，还能看！但是否要开始补涨却还不好说，但继续分摊看着即可。而我们AI硬件的两个中长，一个20CM，一个10CM，强度不缺，毕竟能定义中长本身就代表了不同的态度。", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}, {"text": "\n", "orig_text": "\n", "type": "RICH_TEXT_NODE_TYPE_TEXT", "jump_url": "", "icon_url": "", "icon_name": "", "rid": "", "emoji": null, "goods": null, "style": null, "pics": [], "video": null}], "paragraphs": [{"para_type": 1, "align": 0, "format": {"align"